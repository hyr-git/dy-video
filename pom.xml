                    <execution>
                        <id>process-classes</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>build</goal>
                        </goals>
                        <configuration>
                            <classifier>windows-x86_64</classifier>
                            &lt;!&ndash; 显式指定需要加载的类 &ndash;&gt;
